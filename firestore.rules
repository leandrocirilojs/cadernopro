rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /subjects/{subjectId} {
      allow read, write: if true;
    }
    match /notebook_elements/{elementId} {
      allow read, write: if true;
    }
    match /my_apps/{appId} {
      allow read, write: if true;
    }
  }
}
